# ==========================================
# Civic Tech Waste Management App Configuration
# Indian Municipalities & ULBs - Swachh Bharat Abhiyan
# ==========================================

# Application Settings
APP_NAME=Civic Tech Waste Management ULB
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
TIMEZONE=Asia/Kolkata

# Security & JWT Auth
JWT_SECRET=super-secret-key-change-in-production-ulb-swachh-bharat-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=civic_waste_db

# Google Gemini Vision AI
# Get key from https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Municipal ULB Information
MUNICIPAL_NAME=Bruhat Bengaluru Mahanagara Palike
MUNICIPAL_CODE=BBMP-01
DEFAULT_LATITUDE=12.9716
DEFAULT_LONGITUDE=77.5946

# File Storage
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
